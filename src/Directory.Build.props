<Project>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="ProductInfo">
    <Authors>Nethermind</Authors>
    <Copyright>Demerzel Solutions Limited</Copyright>
    <SourceRevisionId Condition="'$(Commit)' != ''">$(Commit.Substring(0, 8))</SourceRevisionId>
    <!-- Major = native ABI version (nlean_abi_version), so an ABI change is a visible major bump. -->
    <VersionPrefix>9.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <!-- The NethermindEth/nethermind commit whose tools/lean-ffi the binaries under runtimes/ are built from. Set by Build Lean. -->
    <LeanSourceRevision>0260e692fcf8e6b8bcb41289d877e0d5e380b5cd</LeanSourceRevision>
  </PropertyGroup>

</Project>
