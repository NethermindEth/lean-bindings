{
  "label": "reference calibration (template: replace hosts, budgets and refs)",
  "key": "committed",
  "lib_ref": "origin/feature/eip8288-committed-key",
  "batch_lib_ref": "origin/feature/eip8288-batch-leaves",
  "gas_limits": [60000000, 100000000],
  "builder_budget_s": 6.0,
  "validator_budget_s": 3.0,
  "reference_workers": 16,
  "workers": {
    "mode": "remote",
    "hosts": ["10.0.0.11:47100", "10.0.0.12:47100"],
    "launch": "sh -c \"scp -q {token_file} {host}:calibration/token && ssh {host} 'cd calibration && chmod 600 token && LEANVM_NUM_THREADS={threads} CALIB_TOKEN_FILE=token ./calib-worker --remote 0.0.0.0:{port} {host}:{port}'\""
  },
  "threads_per_worker": 11,
  "memory_per_worker_gb": 32,
  "margin": 1.5,
  "fanin": 4,
  "sigs_per_node": 64,
  "bounds": {"code_log": 11, "trace_log": 30, "inner_log_inv_rate": 1, "claims": 256, "max_inner_proofs_per_step": 16},
  "preflight": {"mode": "refuse", "usable_fraction": 0.8},
  "reps": 5,
  "max_iterations": 3,
  "evm_fraction": 0.5,
  "evm": {"imports": [{"format": "gas-benchmarks", "path": "evm/results"}]},
  "tx": {"signature_gas": 4040, "frames_per_tx": 1},
  "quiet": {"max_load1": 1, "timeout_s": 3600}
}
